{
  "compilerOptions": {
    "target": "ES2022", "types": ["vite/client", "node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["app/**/*.ts", "demos/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"]
}
